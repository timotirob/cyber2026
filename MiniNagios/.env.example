# Modèle de configuration du Mini Nagios.
#
# Recopiez ce fichier sous le nom .env (à côté du docker-compose.yml) et
# remplacez les valeurs. Le vrai .env est exclu de Git : il ne doit JAMAIS être
# versionné, contrairement à ce modèle, qui ne contient aucun secret réel.
#
#   cp .env.example .env
#
# Ce fichier est lu deux fois, par deux mécanismes différents :
#   - par Docker Compose, pour créer le conteneur PostgreSQL ;
#   - par la bibliothèque Dotenv depuis config/bootstrap.php, pour alimenter
#     $_ENV dans le code PHP.

# Nom du service PostgreSQL dans docker-compose.yml (et non "localhost" :
# depuis le conteneur PHP, la base n'est pas sur la même machine).
DB_HOST=postgres-db
DB_PORT=5432

DB_NAME=mininagios

# --- Superutilisateur PostgreSQL ---------------------------------------------
# Utilisé par Docker Compose pour initialiser le conteneur, et pour exécuter
# les migrations. L'application ne se connecte JAMAIS avec ce compte.
DB_SUPER_USER=changez_moi
DB_SUPER_PASS=changez_moi

# --- Compte applicatif -------------------------------------------------------
# Celui que le code PHP utilise (src/Database.php). Le rôle mininagios_app est
# créé par migrations/004_roles_moindre_privilege.sql, avec des droits limités
# au strict nécessaire ; son mot de passe se définit avec la commande ALTER
# ROLE documentée dans le README (étape 5).
DB_USER=mininagios_app
DB_PASS=changez_moi

# Clé partagée protégeant l'API REST (en-tête HTTP X-API-KEY).
API_SECRET_KEY=changez_moi
